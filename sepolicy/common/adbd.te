# Don't declare 'type adbd' — it's already defined upstream

# Keep only exec type declaration if needed
type adbd_exec, exec_type, file_type;

# This macro sets up adbd as a domain (already declared in base SEPolicy)
init_daemon_domain(adbd)

# Recovery-specific permissive mode for debugging (userdebug or eng only)
recovery_only(`
    userdebug_or_eng(`
        permissive adbd;
    ')
')
